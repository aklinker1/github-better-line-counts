{
  "name": "github-better-line-counts",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "check": "check",
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "prepare": "simple-git-hooks",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@pinia/colada": "^0.14.0",
    "pinia": "^3.0.0",
    "@webext-core/messaging": "^4.0.0",
    "@webext-core/proxy-service": "^3.0.2",
    "fast-deep-equal": "^3.1.3",
    "minimatch": "^10.0.1",
    "ofetch": "^1.4.1",
    "superlock": "^1.3.5"
  },
  "devDependencies": {
    "@aklinker1/check": "^2.1.2",
    "@aklinker1/generate-changelog": "^1.1.2",
    "@types/bun": "^1.1.11",
    "@types/chrome": "^0.0.278",
    "@types/jsdom": "^21.1.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@wxt-dev/i18n": "^0.2.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "env-cmd": "^10.1.0",
    "fast-glob": "^3.3.2",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "oxlint": "^1.24.0",
    "prettier": "^3.3.3",
    "publish-browser-extension": "^2.2.2",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue": "^3.6.0-rc.8",
    "vue-tsc": "^3.3.11",
    "web-ext": "^10.5.0",
    "wxt": "latest"
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
